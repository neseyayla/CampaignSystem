{
  "ConnectionStrings": {
    // Set the real value with User Secrets, never in this file:
    //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<value>" --project CampaignSystem
    "DefaultConnection": ""
  },
  "Jwt": {
    // Set the real key with User Secrets, never in this file. Anyone holding it can mint a
    // token for any customer:
    //   dotnet user-secrets set "Jwt:SigningKey" "<at least 32 characters>" --project CampaignSystem
    "SigningKey": "",
    "Issuer": "CampaignSystem",
    "Audience": "CampaignSystem.Customer",
    // How long a customer stays signed in. There is no revocation list, so a stolen token
    // is only stopped by running out.
    "LifetimeMinutes": 60
  },
  "RewardCalculation": {
    // Days after a campaign ends before its rewards are loaded. Set by the business.
    "DaysAfterCampaignEnd": 0
  },
  "DailyBatch": {
    // Set Enabled to false when an external scheduler calls POST /api/batch/run instead.
    "Enabled": true,
    "RunAt": "02:00"
  },
  "Elasticsearch": {
    // Empty here so a plain local run logs only to console and file. The Docker compose sets
    // this to the elasticsearch service, which turns the central sink on.
    "Uri": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // The framework's own chatter stays at Warning so it does not drown out the
        // application's logs; EF Core would otherwise log every SQL statement at Information.
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
