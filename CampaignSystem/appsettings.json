{
  "ConnectionStrings": {
    // Set the real value with User Secrets, never in this file:
    //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<value>" --project CampaignSystem
    "DefaultConnection": ""
  },
  "Jwt": {
    // Set the real key with User Secrets, never in this file. Anyone holding it can mint a
    // token for any customer:
    //   dotnet user-secrets set "Jwt:SigningKey" "<at least 32 characters>" --project CampaignSystem
    "SigningKey": "",
    "Issuer": "CampaignSystem",
    "Audience": "CampaignSystem.Customer",
    // How long a customer stays signed in. There is no revocation list, so a stolen token
    // is only stopped by running out.
    "LifetimeMinutes": 60
  },
  "RewardCalculation": {
    // Days after a campaign ends before its rewards are loaded. Set by the business.
    "DaysAfterCampaignEnd": 0
  },
  "Recommendation": {
    // Kampanya öneri motorunun ayarları. Bunları oynatmak, heuristik için "eğitmek" demek.
    // Her alanın ayrıntısı RecommendationOptions.cs'te. Üç skor ağırlığı (Spend/Trend/Season)
    // üç sentetik veri setiyle (biri elle kurgulanmış, ikisi rastgele) yapılan taramayla
    // belirlendi — bkz. docs/analysis/weight_sweep.py, docs/kampanya-oneri-motoru-rapor.md §B.6.
    "LookbackDays": 90,
    "HorizonDays": 45,
    // 7500: skorun parçası değil, gürültü filtresi. Çok küçük kategorilerin tek büyük işlemle
    // öneri listesine sızmasını engeller.
    "MinimumSpend": 7500,
    "MaxSuggestions": 10,
    // 0.85: hacim ağırlığı. Tek veri setinde 0,65 iyi görünmüştü ama 3 veri seti bunu
    // desteklemedi; küçük düşüş, büyük ama trendi düz kategorilerin sırf ciroyla öne geçmesini
    // bir miktar azaltır.
    "SpendWeight": 0.85,
    // 2.0: ASIL kaldıraç. 1,5 -> ~2,0 üç veri setinde de hem bağımsız istatistiksel sıraya
    // hem enjekte edilen gerçek trende uyumu iyileştirdi.
    "TrendWeight": 2.0,
    // 1.0: SEASONAL_PATTERN öncül tablosu statik, cari yıl kırılımını göremiyor; ağırlığını
    // düşürmek fayda-zarar dengesinde daha iyi. Faz 2'de öncül, veriden öğrenilen endeksle
    // değişecek.
    "SeasonWeight": 1.0,
    "CoverageGapBoost": 1.75,
    "SuggestedRewardRate": 0.02
  },
  "DailyBatch": {
    // Set Enabled to false when an external scheduler calls POST /api/batch/run instead.
    "Enabled": true,
    "RunAt": "02:00"
  },
  "Elasticsearch": {
    // Empty here so a plain local run logs only to console and file. The Docker compose sets
    // this to the elasticsearch service, which turns the central sink on.
    "Uri": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // The framework's own chatter stays at Warning so it does not drown out the
        // application's logs; EF Core would otherwise log every SQL statement at Information.
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
