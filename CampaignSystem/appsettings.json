{
  "ConnectionStrings": {
    // Set the real value with User Secrets, never in this file:
    //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<value>" --project CampaignSystem
    "DefaultConnection": ""
  },
  "RewardCalculation": {
    // Days after a campaign ends before its rewards are loaded. Set by the business.
    "DaysAfterCampaignEnd": 0
  },
  "DailyBatch": {
    // Set Enabled to false when an external scheduler calls POST /api/batch/run instead.
    "Enabled": true,
    "RunAt": "02:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
