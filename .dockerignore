# Build outputs — the image rebuilds these itself; copying them would only bloat the context.
**/bin
**/obj

# IDE / VCS
**/.vs
**/.vscode
.git
.gitignore
**/*.user

# The two Angular apps are separate front ends, not part of the API image.
frontend
customer-frontend

# Data-generation tooling and its large CSV output (hundreds of MB) — not part of the API
# image, and copying it makes every build transfer the whole thing as context.
tools

# Local seed/demo SQL — run by hand, never needed to build the API.
scripts

# Docker's own files
Dockerfile
.dockerignore
docker-compose*.yml
