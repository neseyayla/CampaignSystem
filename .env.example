# Copy this file to ".env" and fill in real values. ".env" is gitignored and never committed.
# docker-compose reads these; they are the only secrets the containers need.

# Strong SA password for the SQL Server container (8+ chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=change-me-strong-password

# JWT signing key — at least 32 characters. Anyone holding it can mint tokens, so keep it secret.
JWT_SIGNING_KEY=change-me-at-least-32-characters-long
